# Trading Analysis Tool - Environment Variables
# Copy this file to .env and fill in your API keys

# Yahoo Finance (no API key needed)
# Uses public API

# Alpha Vantage (optional - for fundamental data)
ALPHA_VANTAGE_API=your_api_key_here

# Finnhub (optional - for real-time data)
FINNHUB_API=your_api_key_here

# CryptoCompare (optional - for crypto data)
CRYPTO_COMPARE_API=your_api_key_here

# Whale Alert (optional - for whale tracking)
WHALE_ALERT_API=your_api_key_here

# Twitter API (optional - for sentiment analysis)
TWITTER_CONSUMER_KEY=your_consumer_key_here
TWITTER_CONSUMER_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# Database (optional - for storing results)
DATABASE_URL=postgresql://user:password@localhost/trading_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_tool.log
